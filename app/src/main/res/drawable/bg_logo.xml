<?xml version="1.0" encoding="utf-8"?>

<!-- LOGISTICS | Fondo premium para el logotipo -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Degradado burgundy corporativo -->
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#50182B"
        android:centerColor="#70243B"
        android:endColor="#8A354F"/>

    <!-- Borde dorado -->
    <stroke
        android:width="1.5dp"
        android:color="#FFC5A46D"/>

    <!-- Esquinas redondeadas -->
    <corners android:radius="20dp"/>

</shape>
